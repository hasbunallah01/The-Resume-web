# Contact form email delivery (Resend, https://resend.com)
RESEND_API_KEY=
# Where new inquiries are delivered
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Veylora <hello@your-domain.com>"
CONTACT_FROM_EMAIL=

# Newsletter signup (optional): adds subscribers to a Resend Audience
# (https://resend.com/audiences) instead of a separate database. Without
# this, subscribers are still emailed to CONTACT_TO_EMAIL but not persisted
# in an audience list.
RESEND_AUDIENCE_ID=

# Public review system (Services page "What Our Clients Say")
# Database: attach a Postgres storage (Vercel Postgres / Neon integration)
# to this project in the Vercel dashboard — it auto-injects DATABASE_URL
# (or POSTGRES_URL). The reviews table is created automatically on first
# use; no manual migration is required.
DATABASE_URL=

# Photo uploads: attach a Blob store (Vercel Blob) to this project in the
# Vercel dashboard — it auto-injects BLOB_READ_WRITE_TOKEN. Without this,
# reviewers can still submit without a photo.
BLOB_READ_WRITE_TOKEN=

# Admin review moderation at /admin/reviews. Pick your own values.
ADMIN_REVIEWS_PASSWORD=
ADMIN_SESSION_SECRET=
